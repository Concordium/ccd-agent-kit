{
  "name": "@ccd-agent-kit/config-utils",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "private": true,
  "description": "Private shared CCD local configuration utilities.",
  "type": "module",
  "nx": {
    "name": "libs/config-utils"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ccd-agent-kit/mcp-utils": "workspace:*",
    "@ccd-agent-kit/piv-utils": "workspace:*",
    "@ccd-agent-kit/sdk-utils": "workspace:*",
    "@concordium/web-sdk": "13.0.0-alpha.2",
    "@noble/ed25519": "^3.2.0",
    "zod": "^4.6.7"
  }
}
