# Target Concordium network: mainnet | testnet | devnet
CCD_NETWORK=mainnet

# Override the node gRPC v2 endpoint (host[:port]).
# Defaults to the public endpoint for CCD_NETWORK.
# CCD_GRPC_ENDPOINT=

# Use TLS when connecting to the node.
CCD_GRPC_TLS=true

# gRPC request timeout in milliseconds.
CCD_GRPC_TIMEOUT_MS=15000

# MCP transport: stdio | http
MCP_TRANSPORT=stdio

# HTTP transport settings (used when MCP_TRANSPORT=http).
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
