{
  "name": "@ccd-agent-kit/ccd-config-manager",
  "nx": {
    "name": "ccd-config-manager"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "version": "0.0.0",
  "description": "Human-facing CLI for managing shared CCD local configuration.",
  "type": "module",
  "bin": {
    "ccd-config-manager": "./dist/bin/ccd-config-manager.js"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/chmod-bins.mjs dist/bin/ccd-config-manager.js",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@ccd-agent-kit/mcp-utils": "workspace:*"
  },
  "dependencies": {
    "@ccd-agent-kit/cli-utils": "workspace:*",
    "@ccd-agent-kit/config-utils": "workspace:*",
    "@ccd-agent-kit/piv-utils": "workspace:*",
    "@ccd-agent-kit/sdk-utils": "workspace:*",
    "@concordium/web-sdk": "13.0.0-alpha.2",
    "@grpc/grpc-js": "^1.14.4",
    "commander": "^15.1.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Concordium/ccd-agent-kit.git",
    "directory": "packages/ccd-config-manager"
  },
  "bugs": {
    "url": "https://github.com/Concordium/ccd-agent-kit/issues"
  },
  "homepage": "https://github.com/Concordium/ccd-agent-kit#readme"
}
