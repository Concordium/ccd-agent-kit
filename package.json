{
  "name": "ccd-agent-kit",
  "version": "0.0.0-development",
  "private": true,
  "license": "Apache-2.0",
  "description": "Monorepo for CCD command-line and MCP tools.",
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "ci:test": "pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "lint:commits": "commitlint",
    "package:tools": "node scripts/package-tools.mjs",
    "patch-coverage": "node scripts/check-patch-coverage.mjs",
    "release": "node scripts/release.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "test": "nx run-many -t test",
    "test:unit": "nx run-many -t test:unit",
    "test:integration": "nx run-many -t test:integration",
    "typecheck": "nx run-many -t typecheck",
    "verify": "node scripts/verify.mjs",
    "test:scripts": "pnpm test:scripts:unit && pnpm test:scripts:integration",
    "test:scripts:unit": "node --test scripts/test/unit/*.test.mjs",
    "test:scripts:integration": "node --test scripts/test/integration/*.test.mjs",
    "verify:affected": "node scripts/verify-affected.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@nx/js": "^22.7.12",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "nx": "^22.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.10"
  }
}
